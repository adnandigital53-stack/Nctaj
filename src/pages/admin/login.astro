---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { verifyPassword, setSessionCookie } from '../../lib/auth';

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');

  if (!env.ADMIN_PASSWORD) {
    error = 'No admin password is set yet. Run: wrangler secret put ADMIN_PASSWORD';
  } else if (await verifyPassword(env, password)) {
    await setSessionCookie(Astro.cookies, env);
    return Astro.redirect('/admin');
  } else {
    error = 'Wrong password.';
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin login — NC Taj</title>
    <style>
      :root { --bg: #0e0e10; --surface: #17171a; --cream: #f5efe6; --saffron: #e8a33d; --hairline: rgba(245,239,230,.12); }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 20px;
        background: var(--bg); color: var(--cream);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      form { width: 100%; max-width: 320px; background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px; padding: 2rem; }
      h1 { font-size: 1.1rem; margin: 0 0 1.5rem; text-align: center; letter-spacing: .02em; }
      h1 span { color: var(--saffron); }
      input {
        width: 100%; background: #1f1f24; border: 1px solid var(--hairline); color: var(--cream);
        border-radius: 6px; padding: .75rem .8rem; font-size: 1rem; margin-bottom: 1rem;
      }
      input:focus { outline: 2px solid var(--saffron); }
      button {
        width: 100%; min-height: 46px; border-radius: 6px; border: 0; background: var(--saffron);
        color: #0e0e10; font-weight: 700; font-size: .95rem; cursor: pointer;
      }
      .error { color: #f3b9b0; font-size: .85rem; margin: -.5rem 0 1rem; }
    </style>
  </head>
  <body>
    <form method="POST">
      <h1>NC TAJ <span>Admin</span></h1>
      {error && <p class="error">{error}</p>}
      <input type="password" name="password" placeholder="Admin password" autofocus required />
      <button type="submit">Log in</button>
    </form>
  </body>
</html>
