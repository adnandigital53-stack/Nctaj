---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCategories, createItem, slugifyUnique } from '../../../lib/menu-db';
import { sniffImageType } from '../../../lib/image-sniff';

const db = env.DB;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const categoryId = String(form.get('categoryId') ?? '');
  const priceRaw = String(form.get('price') ?? '').trim();
  const price = priceRaw === '' ? null : Number(priceRaw);
  const description = String(form.get('description') ?? '').trim();
  const veg = form.get('veg') === '1';
  const bestseller = form.get('bestseller') === '1';
  const photo = form.get('photo') as File | null;

  if (!name) {
    error = 'Name is required.';
  } else if (!categoryId) {
    error = 'Pick a category.';
  } else if (priceRaw !== '' && (!Number.isFinite(price) || price! < 0)) {
    error = 'Price has to be a positive number, or left blank for "Price TBC".';
  } else {
    const id = await slugifyUnique(db, name);
    let photoKey: string | null = null;

    if (photo && photo.size > 0) {
      if (photo.size > 8 * 1024 * 1024) {
        error = 'That photo is over 8MB even after compression — try a different one.';
      } else {
        const buffer = await photo.arrayBuffer();
        const sniffed = sniffImageType(new Uint8Array(buffer.slice(0, 12)));
        if (!sniffed) {
          error = "That file doesn't look like a real photo (JPEG/PNG/WebP) — try a different one.";
        } else {
          photoKey = `menu/${id}-${Date.now()}.jpg`;
          await env.MENU_IMAGES.put(photoKey, buffer, { httpMetadata: { contentType: sniffed } });
        }
      }
    }

    if (!error) {
      await createItem(db, { id, categoryId, name, description, price, veg, bestseller, available: true }, photoKey);
      return Astro.redirect('/admin?added=' + encodeURIComponent(id));
    }
  }
}

const categories = await getCategories(db);
---
<AdminLayout title="Add item">
  <h1>Add a menu item</h1>
  <p class="sub">Shows up on the site the moment you save — no rebuild, no redeploy.</p>

  {error && <div class="flash flash--error">{error}</div>}

  <form method="POST" enctype="multipart/form-data" class="card" id="item-form">
    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required maxlength="80" />
    </div>

    <div class="row">
      <div class="field">
        <label for="categoryId">Category</label>
        <select id="categoryId" name="categoryId" required>
          {categories.map((c) => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="price">Price (₹)</label>
        <input type="number" id="price" name="price" min="0" step="1" placeholder="Leave blank for Price TBC" />
      </div>
    </div>

    <div class="field">
      <label for="description">Description <span style="opacity:.6;">(optional, shown under the name)</span></label>
      <textarea id="description" name="description" rows="2" maxlength="200"></textarea>
    </div>

    <div class="row" style="margin-bottom: 1.1rem;">
      <label class="check"><input type="checkbox" name="veg" value="1" /> Vegetarian</label>
      <label class="check"><input type="checkbox" name="bestseller" value="1" /> Bestseller</label>
    </div>

    <div class="field">
      <label for="photo">Photo <span style="opacity:.6;">(optional — compressed in your browser before upload)</span></label>
      <input type="file" id="photo" name="photo" accept="image/*" />
      <p id="photo-status" style="font-size:.8rem; color:var(--cream-muted); margin:.4rem 0 0;"></p>
    </div>

    <button type="submit" class="btn btn--primary" style="margin-top:.5rem;">Add item</button>
    <a href="/admin" class="btn" style="margin-top:.5rem; margin-left:.5rem;">Cancel</a>
  </form>

  <script src="../../../scripts/photo-compress.ts"></script>
</AdminLayout>
