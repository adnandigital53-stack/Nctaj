---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import MenuItem from '../components/MenuItem.astro';
import AggregatorStrip from '../components/AggregatorStrip.astro';
import site from '../data/site.json';
import { getMenuSafe } from '../lib/menu-db';

export const prerender = false; // live D1 read — admin edits show up with no rebuild

const { menu, error: menuError } = await getMenuSafe(env.DB);
---
<Base path="/menu" title="Menu" description="Biryani, North Indian, desserts, coffee and drinks — the full NC Taj menu.">
  <section class="section section--tight page-head page-head--flush">
    <div class="wrap">
      <p class="eyebrow">The full list</p>
      <h1>Menu</h1>
      <p class="lede">Veg and non-veg, across the full menu. Tap a filter to narrow it down.</p>
    </div>
  </section>

  <div class="wrap">
    {menuError ? (
      <div class="card" style="padding: 2rem; text-align: center; margin-bottom: 2rem;">
        <p style="margin: 0 0 1rem; font-size: var(--step-lg); font-family: var(--font-display);">
          The menu's having trouble loading right now.
        </p>
        <p style="color: var(--cream-muted); margin: 0 0 1.5rem;">
          Give us a call and we'll walk you through it — or check back in a few minutes.
        </p>
        <a class="btn btn--primary" href={`tel:${site.contact.phone[0]?.dial}`}>Call {site.contact.phone[0]?.display}</a>
      </div>
    ) : (
      <Fragment>
        <div class="menu-search">
          <input type="search" id="menu-search" placeholder="Search the menu…" aria-label="Search menu items" autocomplete="off" />
        </div>

        <div class="filters" role="group" aria-label="Filter menu by dietary preference">
          <button class="filter" type="button" data-filter="all" aria-pressed="true">All</button>
          <button class="filter" type="button" data-filter="veg" aria-pressed="false">Veg</button>
          <button class="filter" type="button" data-filter="nonveg" aria-pressed="false">Non-veg</button>

          <nav class="jump" aria-label="Jump to category">
            {menu.categories
              .filter((cat) => cat.items.some((i) => i.available))
              .map((cat) => <a href={`#${cat.id}`} data-jump={cat.id}>{cat.name}</a>)}
          </nav>
        </div>

        <p class="visually-hidden" role="status" aria-live="polite" id="filter-status"></p>
        <p class="menu-search__empty" id="menu-search-empty" hidden>No dishes match your search.</p>

        {menu.categories.filter((cat) => cat.items.some((i) => i.available)).map((cat, catIndex) => (
          <section class="menu-category" id={cat.id} data-category>
            <div class="menu-category__head">
              <p class="eyebrow">{cat.name}</p>
              <p class="menu-category__blurb">{cat.blurb}</p>
            </div>
            <div class="grid grid--3">
              {cat.items.filter((i) => i.available).map((item, i) => (
                // Only the very first category's first row is actually
                // above the fold on load — every other category's "first
                // row" is below it, so only this combination should skip
                // loading="lazy" (see PhotoSlot's `eager` prop).
                <MenuItem item={item} index={i} eager={catIndex === 0 && i < 3} />
              ))}
            </div>
          </section>
        ))}
      </Fragment>
    )}

    <div style="padding-block: clamp(2rem, 6vw, 4rem);">
      <AggregatorStrip placement="menu" />
    </div>
  </div>

  <script is:inline>
    // Registered on the document once, then re-run for every navigation —
    // a soft navigation onto /menu gets working filters either way.
    (() => {
      if (window.__nctajMenu) return;
      window.__nctajMenu = true;

      const initFilters = () => {
        const buttons = document.querySelectorAll('.filter');
        if (!buttons.length) return;

        const items = document.querySelectorAll('.item');
        const categories = document.querySelectorAll('[data-category]');
        const status = document.getElementById('filter-status');
        const searchInput = document.getElementById('menu-search');
        const searchEmpty = document.getElementById('menu-search-empty');

        // Mode (all/veg/nonveg) and the search term are independent axes —
        // a card shows only when it clears both. State lives here rather
        // than being passed around so either the buttons or the search box
        // can trigger a re-render without needing to know about the other.
        let mode = document.querySelector('.filter[aria-pressed="true"]')?.dataset.filter ?? 'all';
        let search = '';

        const matchesSearch = (item) => {
          if (!search) return true;
          const name = item.querySelector('.item__name')?.textContent.toLowerCase() ?? '';
          const desc = item.querySelector('.item__desc')?.textContent.toLowerCase() ?? '';
          return name.includes(search) || desc.includes(search);
        };

        const apply = () => {
          items.forEach((item) => {
            const isVeg = item.dataset.veg === 'true';
            const modeOk = mode === 'all' || (mode === 'veg' && isVeg) || (mode === 'nonveg' && !isVeg);
            item.hidden = !(modeOk && matchesSearch(item));
          });

          // Hide a category heading entirely when the filter empties it.
          let shown = 0;
          categories.forEach((cat) => {
            const visible = cat.querySelectorAll('.item:not([hidden])').length;
            cat.hidden = visible === 0;
            shown += visible;
          });

          if (status) status.textContent = `${shown} items shown`;
          if (searchEmpty) searchEmpty.hidden = !(search && shown === 0);
        };

        buttons.forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = '1';
          btn.addEventListener('click', () => {
            buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
            mode = btn.dataset.filter;

            // FLIP: note where every visible card is, apply the filter at once,
            // then glide each surviving card from its old spot to its new one.
            // The response is instant — a view transition had to snapshot all
            // 17 cards first and made taps wait ~300ms before anything moved.
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const before = new Map();
            if (!reduce) {
              items.forEach((el) => { if (!el.hidden) before.set(el, el.getBoundingClientRect()); });
            }

            apply();

            if (!reduce) {
              items.forEach((el) => {
                const from = before.get(el);
                if (el.hidden || !from) return;   // newly shown cards replay their own entrance
                const to = el.getBoundingClientRect();
                const dx = from.left - to.left;
                const dy = from.top - to.top;
                if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return;
                el.animate(
                  [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
                  { duration: 520, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
                );
              });
            }

            if (typeof window.gtag === 'function') {
              window.gtag('event', 'menu_filter', { filter: mode });
            }
          });
        });

        if (searchInput && !searchInput.dataset.bound) {
          searchInput.dataset.bound = '1';
          // Plain re-render, no FLIP — animating every keystroke is noise,
          // not delight.
          searchInput.addEventListener('input', () => {
            search = searchInput.value.trim().toLowerCase();
            apply();
          });
        }

        // --- scroll-spy for the jump chips --------------------------
        const chips = document.querySelectorAll('[data-jump]');
        if (chips.length && 'IntersectionObserver' in window) {
          window.__nctajSpy?.disconnect();
          const spy = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              chips.forEach((c) =>
                c.setAttribute('aria-current', String(c.dataset.jump === entry.target.id)),
              );
            });
          }, { rootMargin: '-45% 0px -50% 0px' });
          categories.forEach((cat) => spy.observe(cat));
          window.__nctajSpy = spy;
        }
      };

      document.addEventListener('astro:page-load', initFilters);
      if (document.readyState !== 'loading') initFilters();
      else document.addEventListener('DOMContentLoaded', initFilters, { once: true });
    })();
  </script>
</Base>
