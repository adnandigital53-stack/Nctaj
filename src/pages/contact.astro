---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import OpenStatus from '../components/OpenStatus.astro';
const c = site.contact;
---
<Base path="/contact" title="Contact" description="Get in touch with NC Taj — phone, WhatsApp, hours and location.">
  <section class="section page-head">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact</h1>
      <p class="lede" style="margin-bottom: 2rem;">
        For orders, use the apps. For anything else — catering, large orders, or a
        problem with a delivery — reach us directly.
      </p>

      <div class="stagger">
        <div class="detail">
          <p class="detail__label">Phone</p>
          {c.phone?.length
            ? c.phone.map((ph) => (
                <p class="detail__value">
                  <a href={`tel:${ph.dial}`} data-track="call_click" data-placement="contact">{ph.display}</a>
                </p>
              ))
            : <p class="detail__value detail__value--pending">To be added</p>}
        </div>

        <div class="detail">
          <p class="detail__label">WhatsApp</p>
          {c.whatsapp
            ? <p class="detail__value"><a href={`https://wa.me/${c.whatsapp}`} target="_blank" rel="noopener" data-track="whatsapp_click" data-placement="contact">Message us</a></p>
            : <p class="detail__value detail__value--pending">To be added</p>}
        </div>

        <div class="detail">
          <p class="detail__label">Kitchen</p>
          {c.address
            ? <p class="detail__value">{c.address}</p>
            : <p class="detail__value detail__value--pending">To be added</p>}
        </div>

        <div class="detail">
          <p class="detail__label">Hours</p>
          {c.hours
            ? <Fragment>
                <p class="detail__value">{c.hours.display}</p>
                <OpenStatus placement="contact" />
              </Fragment>
            : <p class="detail__value detail__value--pending">To be added</p>}
        </div>
      </div>

      <div style="margin-top: 3rem;">
        <a class="btn btn--primary" href="/order" data-track="order_click" data-placement="contact">Order Now</a>
      </div>
    </div>
  </section>
</Base>
