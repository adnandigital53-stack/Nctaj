{
  // Full Worker now: Astro's Cloudflare adapter builds a server entry that
  // reads/writes D1 for menu data and R2 for photos, with static assets
  // (CSS/JS/fonts/seed photos) served alongside it from dist/client.
  //
  // No "main" here on purpose. The adapter defaults it to the bare specifier
  // "@astrojs/cloudflare/entrypoints/server", which Vite resolves as a
  // module rather than checking it exists on disk up front — a literal path
  // like "./dist/server/entry.mjs" would make the Cloudflare Vite plugin
  // fail every `astro build` on a clean checkout, since it validates that
  // path before the build has produced it. The adapter writes a real,
  // deployable wrangler.json (with main pointing at the actual built entry)
  // into dist/server/ at the end of the build — `npm run deploy` uses that
  // one, not this file, for `wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nc-taj",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // --- D1: menu items + categories, editable from /admin -----------------
  // Real database_id — provisioned via .github/workflows/provision-cloudflare.yml.
  // `astro dev` / `wrangler dev --local` still simulate this locally with no
  // network access needed; this id only matters once actually deployed.
  "d1_databases": [
    { "binding": "DB", "database_name": "nctaj-menu", "database_id": "965d0e4d-d448-4938-b018-80948dadc6ee" }
  ],

  // --- R2: admin-uploaded and seed menu photos ----------------------------
  // Bucket not created yet — R2 isn't enabled on the Cloudflare account.
  // Once it is, re-run .github/workflows/provision-cloudflare.yml: it
  // creates this bucket and re-seeds the photos it skipped, no other
  // changes needed here since bucket_name (not an id) is already correct.
  "r2_buckets": [
    { "binding": "MENU_IMAGES", "bucket_name": "nctaj-menu-images" }
  ],

  // Astro's own session helper wants a KV namespace by default; unused here
  // (auth is a signed cookie, not Astro's session API) but harmless to keep —
  // free tier, no setup cost. Real id, same provisioning workflow as D1 above.
  "kv_namespaces": [
    { "binding": "SESSION", "id": "12f74d82e7cb4ea48ed8f48423e968f2" }
  ],

  // --- Web Push ------------------------------------------------------------
  // The VAPID public key is exactly that — public, sent to every visitor's
  // browser as the applicationServerKey when they subscribe (src/components
  // /Footer.astro) — safe to commit. Its matching private key is the secret
  // half and never goes here; it's VAPID_PRIVATE_KEY_JWK in .dev.vars
  // locally and `wrangler secret put VAPID_PRIVATE_KEY_JWK` in production.
  "vars": {
    "VAPID_PUBLIC_KEY": "BLymN1FN64s3b026DQNYvogKS-Cwv_GewVnOpAPw7-VbdKRLz4VKAo56WeW0McrEbUU1KVEwJ3U73HH_SN4ugjM"
  }
}
