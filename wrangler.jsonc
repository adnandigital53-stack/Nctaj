{
  // Static-assets-only Worker: no `main` entry point, so Cloudflare just
  // serves ./dist from the edge. When the cart arrives, add a `main` script
  // here and the same Worker serves the site AND the API on one domain.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nctaj",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    // Astro builds /menu/index.html; this serves it at /menu without a redirect.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
